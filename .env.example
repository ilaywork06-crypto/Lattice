# ─────────────────────────────────────────────────────────────
#  Lattice — environment configuration (copy to .env for local dev)
# ─────────────────────────────────────────────────────────────

# --- Core API database (PostgreSQL) ---
CORE_POSTGRES_USER=lattice
CORE_POSTGRES_PASSWORD=lattice_dev_pw
CORE_POSTGRES_DB=lattice_core
CORE_DATABASE_URL=postgresql+psycopg://lattice:lattice_dev_pw@postgres-core:5432/lattice_core

# --- Notification service database (separate PostgreSQL) ---
NOTIFY_POSTGRES_USER=lattice
NOTIFY_POSTGRES_PASSWORD=lattice_dev_pw
NOTIFY_POSTGRES_DB=lattice_notify
NOTIFY_DATABASE_URL=postgresql+psycopg://lattice:lattice_dev_pw@postgres-notify:5432/lattice_notify

# --- Redis (event bus + cache) ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production-a-very-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Service URLs (inter-service calls) ---
CORE_API_URL=http://core-api:8000
NOTIFICATION_API_URL=http://notification-service:8001

# --- Email (SMTP via MailHog in dev) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=lattice@example.com
SMTP_USE_TLS=false

# --- Frontend ---
# Base URLs the browser uses to reach the APIs (host-exposed ports)
VITE_CORE_API_URL=http://localhost:8000
VITE_NOTIFICATION_API_URL=http://localhost:8001

# --- Uploaded documents (core API) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# --- Bootstrap admin (the only row created on first run) ---
BOOTSTRAP_ADMIN_EMAIL=admin@lattice.io
BOOTSTRAP_ADMIN_PASSWORD=admin1234
